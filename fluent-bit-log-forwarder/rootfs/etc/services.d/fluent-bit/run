#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the Fluent Bit log forwarder service
# s6-overlay docs: https://github.com/just-containers/s6-overlay
#
# Log content reaches Fluent Bit via the `tail` input, reading files that the
# sibling `supervisor-poller` service maintains. `exec` is deliberately not
# used here: Fluent Bit's own docs note it is compiled out of production
# images (needs /bin/sh) and warn it is a shell-injection risk for untrusted
# command output such as log content.
# ==============================================================================

declare loki_host
declare loki_port
declare loki_tls
declare loki_uri
declare loki_tenant_id
declare loki_user
declare loki_password
declare collect_core_log
declare collect_host_log
declare collect_supervisor_log
declare collect_addon_logs
declare config_file
declare parsers_file
declare log_dir
declare logs_timezone
declare core_log_time_offset

log_dir="/var/log/fluent-bit-src"

loki_host=$(bashio::config 'loki_host')
loki_port=$(bashio::config 'loki_port')
loki_uri=$(bashio::config 'loki_uri')
loki_tenant_id=$(bashio::config 'loki_tenant_id')
loki_user=$(bashio::config 'loki_user')
loki_password=$(bashio::config 'loki_password')
collect_core_log=$(bashio::config 'collect_core_log')
collect_host_log=$(bashio::config 'collect_host_log')
collect_supervisor_log=$(bashio::config 'collect_supervisor_log')
collect_addon_logs=$(bashio::config 'collect_addon_logs')

if bashio::var.true "$(bashio::config 'loki_tls')"; then
    loki_tls="on"
else
    loki_tls="off"
fi

config_file="/etc/fluent-bit/fluent-bit.conf"
parsers_file="/etc/fluent-bit/parsers.conf"

# Home Assistant Core writes home-assistant.log timestamps in local time with
# no UTC offset in the string, so the ha_log_line parser needs that offset to
# convert them to UTC. Resolved from the logs_timezone option (an IANA TZ
# name) so DST is handled correctly as of this service (re)start.
logs_timezone=$(bashio::config 'logs_timezone')
if [[ -n "${logs_timezone}" ]]; then
    core_log_time_offset=$(TZ="${logs_timezone}" date +%z)
fi
core_log_time_offset="${core_log_time_offset:-+0000}"
bashio::log.info "Core log timezone: ${logs_timezone:-unset, defaulting to UTC} (offset ${core_log_time_offset})"

bashio::log.info "Rendering Fluent Bit configuration..."

cat <<EOF > "${parsers_file}"
[PARSER]
    Name        ha_log_line
    Format      regex
    Regex       ^(?<time>\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3}) (?<level>[A-Z]+) \((?<thread>[^)]*)\) \[(?<component>[^\]]*)\] (?<message>.*)\$
    Time_Key    time
    Time_Format %Y-%m-%d %H:%M:%S.%L
    Time_Offset ${core_log_time_offset}
EOF

{
    cat <<EOF
[SERVICE]
    Flush        5
    Log_Level    info
    Parsers_File parsers.conf
    HTTP_Server  Off

EOF

    if bashio::var.true "${collect_core_log}"; then
        cat <<EOF
[INPUT]
    Name           tail
    Tag            ha.core
    Path           ${log_dir}/core.log
    DB             /data/tail-core.db
    Read_from_Head true

EOF
    fi

    if bashio::var.true "${collect_host_log}"; then
        cat <<EOF
[INPUT]
    Name           tail
    Tag            ha.host
    Path           ${log_dir}/host.log
    DB             /data/tail-host.db
    Read_from_Head true

EOF
    fi

    if bashio::var.true "${collect_supervisor_log}"; then
        cat <<EOF
[INPUT]
    Name           tail
    Tag            ha.supervisor
    Path           ${log_dir}/supervisor.log
    DB             /data/tail-supervisor.db
    Read_from_Head true

EOF
    fi

    if bashio::var.true "${collect_addon_logs}"; then
        cat <<EOF
[INPUT]
    Name           tail
    Tag            ha.addon
    Path           ${log_dir}/addon.log
    DB             /data/tail-addon.db
    Read_from_Head true

EOF
    fi

    cat <<EOF
[FILTER]
    Name    modify
    Match   ha.core
    Add     job ha_core
    Add     source core

[FILTER]
    Name    parser
    Match   ha.core
    Key_Name log
    Parser  ha_log_line
    Reserve_Data On

[FILTER]
    Name    modify
    Match   ha.host
    Add     job ha_host
    Add     source host

[FILTER]
    Name    modify
    Match   ha.supervisor
    Add     job ha_supervisor
    Add     source supervisor

[FILTER]
    Name    modify
    Match   ha.addon
    Add     job ha_addon
    Add     source addon

[OUTPUT]
    Name         loki
    Match        *
    Host         ${loki_host}
    Port         ${loki_port}
    Tls          ${loki_tls}
    Uri          ${loki_uri}
EOF

    if [[ -n "${loki_tenant_id}" ]]; then
        echo "    Tenant_ID    ${loki_tenant_id}"
    fi

    if [[ -n "${loki_user}" ]]; then
        echo "    http_user    ${loki_user}"
        echo "    http_passwd  ${loki_password}"
    fi

    cat <<EOF
    Labels       job=\$job, source=\$source, level=\$level
    Line_Format  json
    Auto_Kubernetes_Labels Off
EOF
} > "${config_file}"

bashio::log.info "Starting Fluent Bit..."
fluent-bit -c "${config_file}"
exit_code=$?
bashio::log.warning "Fluent Bit exited with code ${exit_code}"
exit "${exit_code}"
