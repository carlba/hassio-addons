#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the Fluent Bit log forwarder service
# s6-overlay docs: https://github.com/just-containers/s6-overlay
#
# Log content reaches Fluent Bit via the `systemd` input, reading directly
# from the system journal. `exec` is deliberately not used here: Fluent
# Bit's own docs note it is compiled out of production images (needs
# /bin/sh) and warn it is a shell-injection risk for untrusted command
# output such as log content.
# ==============================================================================

declare loki_host
declare loki_port
declare loki_tls
declare loki_uri
declare loki_tenant_id
declare loki_user
declare loki_password
declare config_file
declare logs_timezone
declare core_log_time_offset

loki_host=$(bashio::config 'loki_host')
loki_port=$(bashio::config 'loki_port')
loki_uri=$(bashio::config 'loki_uri')
loki_tenant_id=$(bashio::config 'loki_tenant_id')
loki_user=$(bashio::config 'loki_user')
loki_password=$(bashio::config 'loki_password')


if bashio::var.true "$(bashio::config 'loki_tls')"; then
    loki_tls="on"
else
    loki_tls="off"
fi

config_file="/etc/fluent-bit/fluent-bit.conf"
mkdir -p /etc/fluent-bit

# Home Assistant Core writes home-assistant.log timestamps in local time with
# no UTC offset in the string, so the ha_log_line parser needs that offset to
# convert them to UTC. Resolved from the logs_timezone option (an IANA TZ
# name) so DST is handled correctly as of this service (re)start.
logs_timezone=$(bashio::config 'logs_timezone')
if [[ -n "${logs_timezone}" ]]; then
    core_log_time_offset=$(TZ="${logs_timezone}" date +%z)
fi
core_log_time_offset="${core_log_time_offset:-+0000}"
bashio::log.info "Core log timezone: ${logs_timezone:-unset, defaulting to UTC} (offset ${core_log_time_offset})"
bashio::log.info "Rendering Fluent Bit configuration..."

journal_path=$(find /var/log/journal -mindepth 1 -maxdepth 1 -type d -print -quit)

jinja2 \
    -D loki_host="${loki_host}" \
    -D loki_port="${loki_port}" \
    -D loki_tls="${loki_tls}" \
    -D loki_uri="${loki_uri}" \
    -D loki_tenant_id="${loki_tenant_id}" \
    -D loki_user="${loki_user}" \
    -D loki_password="${loki_password}" \
    -D journal_path="${journal_path}" \
    /etc/fluent-bit/fluent-bit.conf.j2 > "${config_file}"



bashio::log.info "Starting Fluent Bit..."
fluent-bit -c "${config_file}"
exit_code=$?
bashio::log.warning "Fluent Bit exited with code ${exit_code}"
exit "${exit_code}"
