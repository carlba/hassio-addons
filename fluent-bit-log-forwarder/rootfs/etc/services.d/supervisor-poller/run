#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the supervisor-poller service
# s6-overlay docs: https://github.com/just-containers/s6-overlay
#
# Stream supervision logic lives in run.py; this wrapper only exists to
# source bashio (Python has no equivalent) and hand config values / the
# Supervisor token to it as environment variables.
# ==============================================================================

export SUPERVISOR_TOKEN
export COLLECT_CORE_LOG
export COLLECT_HOST_LOG
export COLLECT_SUPERVISOR_LOG
export COLLECT_ADDON_LOGS

COLLECT_CORE_LOG=$(bashio::config 'collect_core_log')
COLLECT_HOST_LOG=$(bashio::config 'collect_host_log')
COLLECT_SUPERVISOR_LOG=$(bashio::config 'collect_supervisor_log')
COLLECT_ADDON_LOGS=$(bashio::config 'collect_addon_logs')

exec python3 /etc/services.d/supervisor-poller/run.py
